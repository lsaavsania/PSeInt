Algoritmo Ejercicio08
	// Entrada
	Leer nota
	// Cálculos y salidas
	Si nota>=18 y nota <=20 Entonces
		Escribir "Excelente"
	SiNo
		Si nota>=15 y nota<=17 Entonces
			Escribir "Bueno"
		SiNo
			Si nota>=11 y nota <=14 Entonces
				Escribir "Regular"
			SiNo
				Si nota>=0 y nota<=10 Entonces
					Escribir "Desaprobado"
				FinSi
			FinSi
		FinSi
	FinSi
	
FinAlgoritmo
